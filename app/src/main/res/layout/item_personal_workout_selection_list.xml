<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="120sp"
        android:background="@color/white">


        <TextView
            android:id="@+id/personalNameW"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15sp"
            android:layout_marginTop="15sp"
            android:text="Scheda Pull Up"
            android:textSize="25sp"
            android:textStyle="bold" />


        <TextView
            android:id="@+id/personalWorkoutNumberEx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15sp"
            android:layout_marginTop="65sp"
            android:text="N° Esercizi:"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/personalNumberW"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7sp"
            android:layout_marginTop="65sp"
            android:layout_toRightOf="@+id/personalWorkoutNumberEx"
            android:text="6"
            android:textSize="20sp" />

        <ImageButton
            android:id="@+id/modifiespersonalWorkoutPlan"
            android:layout_width="40sp"
            android:layout_height="40sp"
            android:layout_marginLeft="150sp"
            android:layout_marginTop="40sp"
            android:layout_toRightOf="@+id/personalNumberW"
            android:background="@drawable/pencil"
            android:visibility="gone" />

        <ImageButton
            android:id="@+id/deletePersonalWorkoutPlan"
            android:layout_width="40sp"
            android:layout_height="40sp"
            android:layout_marginLeft="20sp"
            android:layout_marginTop="40sp"
            android:layout_toRightOf="@+id/modifiespersonalWorkoutPlan"
            android:background="@drawable/delete_red"
            android:visibility="gone" />


    </RelativeLayout>


</RelativeLayout>