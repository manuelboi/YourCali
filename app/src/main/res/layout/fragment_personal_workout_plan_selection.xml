<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PersonalWorkoutPlanSelectionFragment">

    <TextView
        android:id="@+id/emptypersonalworkout"
        android:layout_width="379dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Ancora nessuna scheda personale aggiunta!"
        android:textAlignment="center"
        android:textSize="25sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="518dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/personalWorkoutRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </ScrollView>

        <Button
            android:id="@+id/createWorkoutPlanButton"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_alignParentRight="true"
            android:layout_centerVertical="true"
            android:layout_marginLeft="330sp"
            android:layout_marginTop="-50sp"
            android:layout_marginRight="20dp"
            android:autoSizeTextType="uniform"
            android:background="@drawable/roundedbutton"
            android:text="+"
            android:visibility="gone" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="47dp" />

        <Button
            android:id="@+id/cancelManagingWorkoutPlansButton"
            android:layout_width="match_parent"
            android:layout_height="50sp"
            android:layout_marginHorizontal="50sp"
            android:text="Annulla"
            android:visibility="gone" />

        <Button
            android:id="@+id/manageWorkoutPlansButton"
            android:layout_width="match_parent"
            android:layout_height="50sp"
            android:layout_marginHorizontal="50dp"
            android:text="Gestisci schede personali"
            tools:ignore="TouchTargetSizeCheck" />

    </LinearLayout>


</FrameLayout>