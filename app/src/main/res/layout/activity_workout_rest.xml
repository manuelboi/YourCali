<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar4"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/Orange"
            android:minHeight="?attr/actionBarSize"
            android:theme="@style/MyThemeOverlay_Toolbar2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="268sp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="339sp"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <Space
                    android:layout_width="337sp"
                    android:layout_height="16sp" />

                <ImageView
                    android:id="@+id/exerciseImage"
                    android:layout_width="289sp"
                    android:layout_height="253sp"
                    android:layout_marginStart="50sp"
                    android:contentDescription="@string/immagine_esercizio"
                    tools:srcCompat="@tools:sample/avatars" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/infoButton"
                android:layout_width="50sp"
                android:layout_height="50sp"
                android:contentDescription="@string/informazioni_esercizio"
                app:srcCompat="@android:drawable/ic_dialog_info" />

        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="16sp" />

        <TextView
            android:id="@+id/exerciseName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nome esercizio"
            android:textAlignment="center"
            android:textSize="30sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="11sp" />

        <TextView
            android:id="@+id/restTimeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/tempo_di_recuperoU"
            android:textAlignment="center"
            android:textColor="#000000"
            android:textSize="20sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20sp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="00:30"
                android:textAlignment="center"
                android:textSize="90sp" />

            <ImageButton
                android:id="@+id/pauseButton"
                android:layout_width="50sp"
                android:layout_height="100sp"
                android:layout_marginTop="15sp"
                android:layout_weight="1"
                android:contentDescription="@string/pausa"
                android:visibility="visible"
                app:srcCompat="@android:drawable/ic_media_pause" />

            <ImageButton
                android:id="@+id/playButton"
                android:layout_width="50sp"
                android:layout_height="100sp"
                android:layout_marginTop="15sp"
                android:layout_weight="1"
                android:contentDescription="@string/riparti"
                android:visibility="gone"
                app:srcCompat="@android:drawable/ic_media_play" />

        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="17sp" />

        <Button
            android:id="@+id/startNowButton"
            android:layout_width="148sp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="135sp"
            android:backgroundTint="#A60F0F"
            android:text="@string/riparti_ora"
            android:textSize="14sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="18sp" />

        <TextView
            android:id="@+id/remainingSets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Serie rimanenti"
            android:textAlignment="center"
            android:textSize="20sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="18sp" />

        <Button
            android:id="@+id/skipExerciseButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#3F51B5"
            android:text="@string/salta_questo_esercizio" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>