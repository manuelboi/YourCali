<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/Cranberry"
            android:minHeight="?attr/actionBarSize"
            android:theme="@style/MyThemeOverlay_Toolbar2" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="269dp"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="342dp"
                android:layout_height="match_parent"
                android:orientation="vertical">

                <Space
                    android:layout_width="344dp"
                    android:layout_height="16dp" />

                <ImageView
                    android:id="@+id/exerciseImage"
                    android:layout_width="299dp"
                    android:layout_height="253dp"
                    android:layout_marginStart="50sp"
                    android:contentDescription="@string/immagine_esercizio"
                    tools:srcCompat="@tools:sample/avatars" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/infoButton"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:contentDescription="@string/informazioni_esercizio"
                app:srcCompat="@android:drawable/ic_dialog_info" />

        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <TextView
            android:id="@+id/exerciseName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nome esercizio"
            android:textAlignment="center"
            android:textSize="30sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="73dp" />

        <TextView
            android:id="@+id/reps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Numero di ripetizioni"
            android:textAlignment="center"
            android:textColor="#000000"
            android:textSize="30sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="55dp" />

        <Button
            android:id="@+id/doneButton"
            android:layout_width="112dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="150dp"
            android:backgroundTint="#8BC34A"
            android:text="@string/fatto" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="79dp" />

        <Button
            android:id="@+id/skipExerciseButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="#3F51B5"
            android:text="@string/salta_questo_esercizio" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>