<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/myToolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/Orange"
                android:minHeight="?attr/actionBarSize"
                android:theme="@style/MyThemeOverlay_Toolbar2" />

        </com.google.android.material.appbar.AppBarLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/exerciseConfigurationInfoImage"
                android:layout_width="311dp"
                android:layout_height="253dp"
                android:layout_marginTop="20dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="@string/immagine_esercizio"
                tools:srcCompat="@tools:sample/avatars" />

        </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <TextView
            android:id="@+id/exerciseConfigurationInfoName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nome esercizio"
            android:textAlignment="center"
            android:textSize="30sp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="20dp" />

        <TextView
            android:id="@+id/bodyPartConfigurationInfoLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="30dp"
            android:textSize="20dp"
            android:text="@string/zona_allenataU" />

        <TextView
            android:id="@+id/bodyPartConfigurationInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Parte del corpo allenata"
            android:textSize="20dp"
            android:layout_marginHorizontal="30dp"/>

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <TextView
            android:id="@+id/difficultyConfigurationInfoLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="30dp"
            android:textSize="20dp"
            android:text="@string/difficoltaU" />

        <TextView
            android:id="@+id/difficultyConfigurationInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="30dp"
            android:textSize="20dp"
            android:text="Difficoltà dell'esercizio" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="16dp" />

        <TextView
            android:id="@+id/helpGuideConfigurationInfoLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="30dp"
            android:textSize="20dp"
            android:text="@string/guida_all_esecuzioneU" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginHorizontal="30dp">

            <TextView
                android:id="@+id/helpGuideConfigurationInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="20dp"
                android:text="Guida all'esecuzione dell'esercizio:" />

        </ScrollView>

        <Button
            android:id="@+id/addButtonConfigurationInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginHorizontal="100dp"
            android:backgroundTint="#3F51B5"
            android:text="Aggiungi" />


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>