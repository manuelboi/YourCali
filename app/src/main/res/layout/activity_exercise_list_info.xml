<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/myToolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/Orange"
                android:minHeight="?attr/actionBarSize"
                android:theme="@style/MyThemeOverlay_Toolbar2" />

        </com.google.android.material.appbar.AppBarLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="592dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/exerciseConfigurationInfoImage"
                    android:layout_width="311sp"
                    android:layout_height="253sp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="10sp"
                    android:contentDescription="@string/immagine_esercizio"
                    tools:srcCompat="@tools:sample/avatars" />

                <TextView
                    android:id="@+id/exerciseConfigurationInfoName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Nome esercizio"
                    android:textAlignment="center"
                    android:textSize="30sp" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="55sp" />

                <TextView
                    android:id="@+id/bodyPartConfigurationInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="30sp"
                    android:text="@string/zona_allenataU"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/bodyPart"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="30sp"
                    android:text="Parte del corpo allenata"
                    android:textSize="20sp" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="16sp" />

                <TextView
                    android:id="@+id/difficultyConfigurationInfoLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="30sp"
                    android:text="@string/difficoltaU"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/difficultyConfigurationInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="30sp"
                    android:text="Difficoltà dell'esercizio"
                    android:textSize="20sp" />

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="16sp" />

                <TextView
                    android:id="@+id/helpGuideConfigurationInfoLabel"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="30sp"
                    android:text="@string/guida_all_esecuzioneU"
                    android:textSize="20sp" />

                <TextView
                    android:id="@+id/helpGuideConfigurationInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="30sp"
                    android:text="Guida all'esecuzione dell'esercizio"
                    android:textSize="20sp" />

            </LinearLayout>

        </ScrollView>

        <Space
            android:layout_width="match_parent"
            android:layout_height="15sp" />

        <Button
            android:id="@+id/addButtonConfigurationInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginHorizontal="100sp"
            android:backgroundTint="#3F51B5"
            android:text="Aggiungi" />


    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>