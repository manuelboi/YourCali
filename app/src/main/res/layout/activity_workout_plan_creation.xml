<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".WorkoutPlanCreationActivity">




    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        tools:layout_editor_absoluteX="0dp"
        tools:layout_editor_absoluteY="171dp">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/myToolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/Orange"
                android:minHeight="?attr/actionBarSize"
                android:theme="@style/MyThemeOverlay_Toolbar2" />

        </com.google.android.material.appbar.AppBarLayout>




        <Space
            android:layout_width="match_parent"
            android:layout_height="25dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginLeft="30dp"
            android:text='Nome'
            android:textSize="20sp" />

        <EditText
            android:id="@+id/workoutPlanName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="30dp"
            android:hint=""
            android:minHeight="48dp" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="20dp" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="30dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="50dp"
                android:text="Nome" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="150dp"
                android:text="Rep" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="190dp"
                android:text="Serie" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="265dp"
                android:text="Gestisci" />


        </RelativeLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="453dp">

            <TextView
                android:id="@+id/emptyworkoutplancreation"
                android:layout_width="376dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Ancora nessun esercizio personale aggiunto!"
                android:textAlignment="center"
                android:textSize="25sp"
                android:visibility="gone"
                tools:ignore="MissingConstraints"
                tools:layout_editor_absoluteY="400dp" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="441dp"
                android:layout_marginHorizontal="30dp"
                android:layout_weight="1"
                android:fillViewport="true">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="440dp"
                    android:background="@color/white">


                </androidx.recyclerview.widget.RecyclerView>

            </ScrollView>


        </LinearLayout>


        <ImageButton
            android:id="@+id/aggiungiEsercizio"
            android:layout_width="50sp"
            android:layout_height="50sp"
            android:layout_centerVertical="true"
            android:layout_marginLeft="330sp"
            android:layout_marginTop="-60sp"
            android:background="@drawable/roundedbutton"
            android:backgroundTint="@color/Orange"
            android:src="@drawable/plus"
            android:text="+"
            android:visibility="visible" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="15dp" />


        <Button
            android:id="@+id/savePersonalWorkoutPlanButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="100dp"
            android:backgroundTint="#8BC34A"
            android:text="@string/salva"
            android:textSize="17dp" />


    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>