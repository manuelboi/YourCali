<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".PersonalExerciseFragment">

    <TextView
        android:id="@+id/emptypersonalexercise"
        android:layout_width="376sp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="Ancora nessun esercizio personale aggiunto!"
        android:textAlignment="center"
        android:textSize="25sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="518sp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/personalExerciseRecycler"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

        </ScrollView>

        <ImageButton
            android:id="@+id/createExerciseButton"
            android:layout_width="50sp"
            android:layout_height="50sp"
            android:layout_centerVertical="true"
            android:layout_marginLeft="330sp"
            android:layout_marginTop="-50sp"
            android:background="@drawable/roundedbutton"
            android:backgroundTint="@color/Orange"
            android:src="@drawable/plus"
            android:text="+"
            android:visibility="gone" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="47sp" />

        <Button
            android:id="@+id/cancelManagingExercisesButton"
            android:layout_width="match_parent"
            android:layout_height="50sp"
            android:layout_marginHorizontal="50sp"
            android:backgroundTint="@color/Cranberry"
            android:text="Annulla"
            android:visibility="gone" />

        <Button
            android:id="@+id/manageExercisesButton"
            android:layout_width="match_parent"
            android:layout_height="50sp"
            android:layout_marginHorizontal="50sp"
            android:backgroundTint="#3F51B5"
            android:text="Gestisci esercizi personali"
            tools:ignore="TouchTargetSizeCheck" />

    </LinearLayout>

</FrameLayout>