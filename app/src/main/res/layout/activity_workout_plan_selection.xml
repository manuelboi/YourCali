<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".WorkoutPlanSelectionActivity">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/myToolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/Orange"
                android:minHeight="?attr/actionBarSize"
                android:theme="@style/MyThemeOverlay_Toolbar2" />

        </com.google.android.material.appbar.AppBarLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/LightOrange"
            app:tabIndicatorColor="#8190A5"
            app:tabSelectedTextColor="#FFFFFF"
            app:tabTextColor="#97FFFFFF">

            <com.google.android.material.tabs.TabItem
                android:id="@+id/predefinedTab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/predefinite" />

            <com.google.android.material.tabs.TabItem
                android:id="@+id/personalTab"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/personali" />

        </com.google.android.material.tabs.TabLayout>

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/viewPager"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:ignore="SpeakableTextPresentCheck" />


    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>