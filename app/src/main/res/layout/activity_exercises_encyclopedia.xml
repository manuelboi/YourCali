<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".WorkoutPlanSelectionActivity">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <com.google.android.material.appbar.AppBarLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/myToolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F48748"
                android:minHeight="?attr/actionBarSize"
                android:theme="?attr/actionBarTheme" />

        </com.google.android.material.appbar.AppBarLayout>

        <com.google.android.material.tabs.TabLayout
            android:id="@+id/tabLayoutEncyclopedia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FF955A"
            app:tabIndicatorColor="#8190A5"
            app:tabSelectedTextColor="#000000"
            app:tabTextColor="#97000000">

            <com.google.android.material.tabs.TabItem
                android:id="@+id/predefinedTabEncyclopedia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/predefiniti" />

            <com.google.android.material.tabs.TabItem
                android:id="@+id/personalTabEncyclopedia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/personali" />

        </com.google.android.material.tabs.TabLayout>

        <androidx.viewpager.widget.ViewPager
            android:id="@+id/viewPagerEncyclopedia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            tools:ignore="SpeakableTextPresentCheck" />


    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>