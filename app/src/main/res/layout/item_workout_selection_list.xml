<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="120sp"
        android:background="#FFFFFF">


        <TextView
            android:id="@+id/nameW"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15sp"
            android:layout_marginTop="15sp"
            android:text="Scheda Pull Up"
            android:textSize="25sp"
            android:textStyle="bold" />


        <TextView
            android:id="@+id/workoutNumberEx"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15sp"
            android:layout_marginTop="50sp"
            android:text="N° Esercizi:"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/numberW"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7sp"
            android:layout_marginTop="50sp"
            android:layout_toRightOf="@+id/workoutNumberEx"
            android:text="6"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/workoutDifficulty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="15sp"
            android:layout_marginTop="80sp"
            android:text="Difficoltà:"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/diffW"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginLeft="7sp"
            android:layout_marginTop="80sp"
            android:layout_toRightOf="@+id/workoutDifficulty"
            android:text="Facile"
            android:textSize="20sp" />


    </RelativeLayout>


</RelativeLayout>